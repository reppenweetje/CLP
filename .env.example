# Environment-variabelen voor de CLP-frontend.
#
# Niet committen met echte waarden. Kopieer dit bestand naar `.env.local` voor
# lokale dev (wordt door .gitignore genegeerd via *.local). In Vercel: zet
# dezelfde keys via Project Settings → Environment Variables (Production + Preview).
#
# Alle VITE_-prefixed vars worden door Vite naar de client-bundle geinjecteerd
# en zijn dus zichtbaar voor elke bezoeker. Plaats hier NOOIT secrets — alleen
# publieke keys (anon-key) en config-flags.

# ── Supabase: lead-upsert Edge Function ─────────────────────────────────────

# Project URL — staat ook publiek in browser network-tabs
VITE_SUPABASE_URL=https://xxx.supabase.co

# Anon key — JWT token met role=anon. Publiek bedoeld; bescherming komt van
# RLS-policies op de tabellen, niet van key-geheimhouden.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Path naar de Edge Function. Default klopt voor Supabase hosted projects.
VITE_LEAD_UPSERT_PATH=/functions/v1/lead-upsert

# Source-tag waarmee deze CLP zijn leads markeert in `leads.source`. Per
# project anders: clp_dehofman, clp_<volgendeklant>, etc. Wordt gebruikt
# voor segmentering in de CRM en Slack-notifies.
VITE_CLP_SOURCE=clp_dehofman

# ── Feature-flags ──────────────────────────────────────────────────────────

# Master-switch voor de Supabase-koppeling. Op 'false' draait de chat puur
# op localStorage (zoals voor de koppeling). Op 'true' worden lead-events en
# consent-events naar de Edge Function gepusht. Gebruikt om gefaseerd te
# kunnen activeren zonder een nieuwe deploy te draaien.
VITE_SUPABASE_ENABLED=false

# ── Plausible (zie .env.plausible.local.example) ───────────────────────────
# VITE_PLAUSIBLE_DOMAIN=...
