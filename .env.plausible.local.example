# Plausible API credentials voor scripts/setup-plausible-goals.mjs.
# Kopieer dit bestand naar .env.plausible.local en vul in.
# .env.plausible.local is gitignored (via *.local in .gitignore).
#
# Genereer een API key op:
#   https://plausible.io/settings/api-keys
# Vereiste scopes:
#   sites:provision:goals:write
#   sites:provision:goals:read
#
# PLAUSIBLE_SITE_ID = je domein in Plausible, zonder protocol.
# Aanbeveling: gebruik clp.repp.nl als umbrella-property zodat alle
# huidige + toekomstige CLPs onder één Plausible-site landen en je
# cross-CLP funnels kan vergelijken.

PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=clp.repp.nl
